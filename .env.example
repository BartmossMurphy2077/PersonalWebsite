# Single source of truth for environment variables.
# Copy to .env (in this repo root) and fill in real values. .env is gitignored.
#
#   cp .env.example .env        # macOS/Linux
#   copy .env.example .env      # Windows
#
# Both the local dev server (BackEnd/backend.py) and Docker Compose
# (infrastructure/docker-compose.yml) read this same root .env.

# Secret used to sign session cookies. Use a long random string.
SECRET_KEY=change-me-to-a-long-random-string

# Password for the /admin dashboard login.
ADMIN_PASSWORD=change-me

# Optional overrides for local runs (Docker sets these itself):
# DATABASE_URL=sqlite:///portfolio.db
# UPLOAD_FOLDER=uploads
