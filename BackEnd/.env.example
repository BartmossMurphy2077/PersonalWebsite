# Copy to .env and fill in real values. .env is gitignored.

# Secret key used to sign session cookies. Use a long random string.
SECRET_KEY=change-me-to-a-long-random-string

# Password for the /admin dashboard login.
ADMIN_PASSWORD=change-me

# Optional overrides (sensible defaults are used if omitted):
# DATABASE_URL=sqlite:///portfolio.db
# UPLOAD_FOLDER=uploads
